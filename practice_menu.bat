@echo off
setlocal EnableExtensions DisableDelayedExpansion
set "PRACTICE_SELF=%~f0"
set "PRACTICE_EXPORT=%~dp0LabB1"
if /i "%~1"=="--extract" goto extract_cli
set "PRACTICE_TARGET=%TEMP%\SecurityPractice-%RANDOM%-%RANDOM%"
call :extract
if errorlevel 1 goto extraction_failed
pushd "%PRACTICE_TARGET%"
if errorlevel 1 exit /b 1
goto menu

:extract_cli
if "%~2"=="" (
    echo Usage: practice_menu.bat --extract "destination folder"
    exit /b 1
)
set "PRACTICE_TARGET=%~f2"
call :extract
if errorlevel 1 exit /b 1
echo All 12 source files saved to "%PRACTICE_TARGET%".
exit /b 0

:extract
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; try { $text=[IO.File]::ReadAllText($env:PRACTICE_SELF); $match=[regex]::Match($text,'(?m)^::PAYLOAD:([^\r\n]+)'); if(-not $match.Success){throw 'Embedded code is missing'}; $data=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($match.Groups[1].Value)) | ConvertFrom-Json; [IO.Directory]::CreateDirectory($env:PRACTICE_TARGET) | Out-Null; foreach($file in $data){ $path=Join-Path $env:PRACTICE_TARGET $file.name; if(Test-Path -LiteralPath $path){throw ('File already exists: '+$path)}; [IO.File]::WriteAllBytes($path,[Convert]::FromBase64String($file.code)) }; exit 0 } catch { Write-Host $_.Exception.Message; exit 1 }"
exit /b %errorlevel%

:extraction_failed
echo Could not unpack the embedded code. Windows PowerShell and a writable TEMP folder are required.
pause
exit /b 1

:menu
cls
echo ========================================
echo           SECURITY PRACTICE CODE
echo ========================================
echo  1. RSA encryption / decryption
echo  2. RSA product
echo  3. RSA signature
echo  4. ElGamal encryption / decryption
echo  5. ElGamal product
echo  6. ElGamal rerandomization
echo  7. ElGamal signature
echo  8. ECC encryption / decryption
echo  9. ECC additive homomorphism
echo  A. Caesar cipher
echo  B. Vernam cipher (XOR)
echo  F. All important functions and examples
echo  0. Exit
echo.
choice /c 123456789ABF0 /n /m "Choose code [1-9, A, B, F, 0]: "
set "selected=%errorlevel%"
if "%selected%"=="13" goto quit
set "source="
if "%selected%"=="1" set "source=b1_rsa_enc_dec.cpp"
if "%selected%"=="2" set "source=b1_rsa_product.cpp"
if "%selected%"=="3" set "source=b1_rsa_signature.cpp"
if "%selected%"=="4" set "source=b1_el_enc_dec.cpp"
if "%selected%"=="5" set "source=b1_el_product.cpp"
if "%selected%"=="6" set "source=b1_el_rrand.cpp"
if "%selected%"=="7" set "source=b1_el_signature.cpp"
if "%selected%"=="8" set "source=b1_ecc_enc_dec.cpp"
if "%selected%"=="9" set "source=b1_ecc_homomorphis.cpp"
if "%selected%"=="10" set "source=b1_caesar_enc_dec.cpp"
if "%selected%"=="11" set "source=b1_vernam_enc_dec.cpp"
if "%selected%"=="12" set "source=b1_all_functions.cpp"
if not defined source goto menu
if not exist "%source%" goto missing

:actions
cls
echo Selected: %source%
echo.
echo  V. View code in this window
echo  C. Copy code to clipboard
echo  E. Edit code in Notepad
echo  R. Compile and run
echo  S. Save this code beside the BAT in LabB1
echo  B. Back to code menu
echo.
choice /c VCERSB /n /m "Choose action [V, C, E, R, S, B]: "
if errorlevel 6 goto menu
if errorlevel 5 goto save
if errorlevel 4 goto run
if errorlevel 3 goto edit
if errorlevel 2 goto copy
if errorlevel 1 goto view
goto menu

:view
cls
type "%source%" | more
echo.
pause
goto actions

:copy
clip < "%source%"
if errorlevel 1 goto copy_failed
echo Code copied. Press Ctrl+V to paste it into your editor.
pause
goto actions

:copy_failed
echo Copy failed. Use View or Edit to access the code.
pause
goto actions

:edit
start "" notepad.exe "%source%"
goto actions

:save
if not exist "%PRACTICE_EXPORT%" mkdir "%PRACTICE_EXPORT%"
if not exist "%PRACTICE_EXPORT%" goto save_failed
copy /-y "%source%" "%PRACTICE_EXPORT%\%source%"
if errorlevel 1 goto save_failed
echo Saved to "%PRACTICE_EXPORT%\%source%".
pause
goto actions

:save_failed
echo Could not save the file. Use Copy, or Edit and Notepad's Save As.
pause
goto actions

:run
set "compiler=g++.exe"
where g++.exe >nul 2>nul
if not errorlevel 1 goto compile
if exist "C:\mingw64\bin\g++.exe" (
    set "compiler=C:\mingw64\bin\g++.exe"
    goto compile
)
echo g++ was not found. Add your MinGW bin folder to PATH.
echo View, Copy, and Edit still work without a compiler.
pause
goto actions

:compile
if not exist "%PRACTICE_EXPORT%" mkdir "%PRACTICE_EXPORT%"
if not exist "%PRACTICE_EXPORT%" goto output_failed
set "program=%PRACTICE_EXPORT%\%source:.cpp=.exe%"
echo Compiling %source% ...
"%compiler%" -std=c++17 "%source%" -o "%program%"
if errorlevel 1 goto compile_failed
echo.
echo Running %program%
echo ----------------------------------------
"%program%"
echo.
echo Program exit code: %errorlevel%
pause
goto actions

:compile_failed
echo Compilation failed. Read the error above and use Edit to fix the code.
pause
goto actions

:output_failed
echo Could not create the output folder. Check folder permissions.
pause
goto actions

:missing
echo Missing file: %source%
echo Restart the BAT to unpack its embedded source files again.
pause
goto menu

:quit
popd
endlocal
exit /b 0

::PAYLOAD:
